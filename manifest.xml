<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">
  <Id>52737d1a-60b3-489c-89ee-f31f1bb7ef77</Id>
  <Version>1.2.0.0</Version>
  <ProviderName>DISP Grand Est</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="Assistant IA de rédaction" />
  <Description DefaultValue="Rédige, corrige, reformule et résume les mails Outlook en local avec Qwen via WebLLM." />
  <IconUrl DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/assets/icon.svg" />
  <HighResolutionIconUrl DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/assets/icon.svg" />
  <SupportUrl DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/taskpane.html" />
  <AppDomains>
    <AppDomain>https://snowsnowchowchow.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
      <TabletSettings>
        <SourceLocation DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </TabletSettings>
      <PhoneSettings>
        <SourceLocation DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </PhoneSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
      <TabletSettings>
        <SourceLocation DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </TabletSettings>
      <PhoneSettings>
        <SourceLocation DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/taskpane.html" />
        <RequestedHeight>450</RequestedHeight>
      </PhoneSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
    xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
      xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.3">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="ComposeCopilot.Group">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="ComposeCopilot.ShowTaskpane">
                    <Label resid="TaskpaneButton.Label" />
                    <Supertip>
                      <Title resid="TaskpaneButton.Title" />
                      <Description resid="TaskpaneButton.Description" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16" />
                      <bt:Image size="32" resid="Icon.32" />
                      <bt:Image size="80" resid="Icon.80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/assets/icon.svg" />
          <bt:Image id="Icon.32" DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/assets/icon.svg" />
          <bt:Image id="Icon.80" DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/assets/icon.svg" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/commands.html" />
          <bt:Url id="Taskpane.Url" DefaultValue="https://snowsnowchowchow.github.io/outlook-ia-local/taskpane.html" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Assistant IA" />
          <bt:String id="TaskpaneButton.Label" DefaultValue="Rédiger avec IA" />
          <bt:String id="TaskpaneButton.Title" DefaultValue="Ouvrir l'assistant local" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Description" DefaultValue="Rédige, corrige, reformule et résume sans envoyer le contenu du mail à un backend." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
